# Copy to backend/.env for local development.
DATABASE_URL=postgresql://lordknows:lordknows@127.0.0.1:5432/lordknows
# First admin account, created on start when there are no users yet.
# (Or run: python -m app.users create you@example.com)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long
# Where uploads are stored (default: backend/media)
# MEDIA_ROOT=/data/media
